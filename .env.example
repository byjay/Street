# GEMINI_API_KEY: Optional for Gemini AI / Maps Grounding commentary.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEFAULT_MAP_PROVIDER: 'free-kr' | 'free-global' | 'google'
DEFAULT_MAP_PROVIDER="free-kr"

# === [Free APIs - Public Client Keys] ===
# KAKAO_JS_KEY / VITE_KAKAO_MAP_KEY: Free Kakao Developers JS key for Korean Roadview & Map.
KAKAO_JS_KEY=""
VITE_KAKAO_MAP_KEY=""
# VWORLD_API_KEY: Free VWorld WMTS key for high-res Korea Satellite & Hybrid layers.
VWORLD_API_KEY=""
# MAPILLARY_CLIENT_TOKEN: Free Mapillary client token (MLY|...) for street imagery.
MAPILLARY_CLIENT_TOKEN=""

# === [Free APIs - Server-Only Secrets] ===
KAKAO_REST_API_KEY=""
OSRM_CAR_BASE_URL="https://router.project-osrm.org"
OSRM_FOOT_BASE_URL="https://routing.openstreetmap.de/routed-foot"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="RoadWindow360/1.0"

# === [Optional Paid/Free-Tier Google Maps Connection] ===
# Preserved as switchable 'google' provider option for 360° Street View & 3D Earth.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
